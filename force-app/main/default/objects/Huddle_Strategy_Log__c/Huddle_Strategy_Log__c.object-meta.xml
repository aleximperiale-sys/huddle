<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOverrides>
        <actionName>View</actionName>
        <content>Huddle_Strategy_Log_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
    </actionOverrides>
    <compactLayoutAssignment>Huddle_Strategy_Log_Highlights</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One record per internal deal-strategy meeting. Holds the raw recap, the extracted strategy and the reasoning behind it, linked to the Opportunity. Deliberately a dedicated object rather than a Note or Activity so internal strategy can never be picked up by a customer-facing tool reading Opportunity activity history.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Huddle Strategy Log</label>
    <nameField>
        <displayFormat>STR-{00000}</displayFormat>
        <label>Strategy Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Huddle Strategy Logs</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
