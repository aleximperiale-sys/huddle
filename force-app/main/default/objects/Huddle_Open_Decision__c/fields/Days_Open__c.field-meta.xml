<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Open__c</fullName>
    <label>Days Open</label>
    <type>Number</type>
    <precision>4</precision>
    <scale>0</scale>
    <required>false</required>
    <formula>IF(ISPICKVAL(Status__c, "Resolved"), 0, TODAY() - DATEVALUE(CreatedDate))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <description>How long this has been hanging. Drives the aging list view and the dashboard rollup of questions nobody has come back to.</description>
</CustomField>
